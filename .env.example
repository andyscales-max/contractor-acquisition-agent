# Copy to .env and fill in values.

# SerpAPI key — used for Google Maps discovery.
# Get yours at https://serpapi.com
SERPAPI_KEY=

# Gmail account that will own the drafts (and eventually send).
FROM_EMAIL=
FROM_NAME=

# Where the SQLite ledger lives.
LEDGER_PATH=data/ledger.db

# Gmail OAuth paths.
# 1. Download credentials.json from Google Cloud Console (OAuth 2.0 Client ID, type "Desktop").
# 2. Place it at the path below.
# 3. First run will open a browser for consent and write GMAIL_TOKEN_PATH.
GMAIL_CREDENTIALS_PATH=credentials.json
GMAIL_TOKEN_PATH=data/gmail_token.json

# Optional: HTTP timeout seconds for website crawls.
HTTP_TIMEOUT=10

# Optional: max concurrent crawls during enrichment.
ENRICHMENT_WORKERS=5
